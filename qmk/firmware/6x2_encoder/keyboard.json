{
    "keyboard_name": "Dice and Layers 6x2 Encoder",
    "url": "https://dice-and-layers.github.io/pico-pad/",
    "maintainer": "Dice and Layers",
    "manufacturer": "Dice and Layers",
    "usb": {
        "vid": "0x444C",
        "pid": "0x0002",
        "device_version": "0.0.1"
    },
    "processor": "RP2040",
    "bootloader": "rp2040",
    "board": "GENERIC_RP_RP2040",
    "diode_direction": "ROW2COL",
    "features": {
        "bootmagic": true,
        "command": false,
        "console": false,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "rgblight": false,
        "encoder": true,
        "via": true,
        "oled": false
    },
    "matrix_pins": {
        "cols": ["GP6", "GP7", "GP8", "GP9", "GP10", "GP11"],
        "rows": ["GP12", "GP13", "GP14"]
    },
    "encoder": {
        "rotary": [
            {
                "pin_a": "GP2",
                "pin_b": "GP3"
            }
        ]
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"label": "ENC", "x": 0, "y": 0, "matrix": [0, 5]},
                
                {"label": "K00", "x": 1, "y": 0, "matrix": [0, 0]},
                {"label": "K01", "x": 2, "y": 0, "matrix": [0, 1]},
                {"label": "K02", "x": 3, "y": 0, "matrix": [0, 2]},
                {"label": "K03", "x": 4, "y": 0, "matrix": [0, 3]},
                {"label": "K04", "x": 5, "y": 0, "matrix": [1, 1]},
                {"label": "K05", "x": 6, "y": 0, "matrix": [1, 0]},
                
                {"label": "K10", "x": 1, "y": 1, "matrix": [2, 0]},
                {"label": "K11", "x": 2, "y": 1, "matrix": [2, 1]},
                {"label": "K12", "x": 3, "y": 1, "matrix": [2, 2]},
                {"label": "K13", "x": 4, "y": 1, "matrix": [2, 3]},
                {"label": "K14", "x": 5, "y": 1, "matrix": [1, 3]},
                {"label": "K15", "x": 6, "y": 1, "matrix": [1, 2]}
            ]
        }
    }
}
