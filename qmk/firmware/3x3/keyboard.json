{
    "keyboard_name": "Dice and Layers 3x3",
    "url": "https://dice-and-layers.github.io/pico-pad/",
    "maintainer": "Dice and Layers",
    "manufacturer": "Dice and Layers",
    "usb": {
        "vid": "0x444C",
        "pid": "0x0005",
        "device_version": "0.0.1"
    },
    "processor": "RP2040",
    "bootloader": "rp2040",
    "board": "GENERIC_RP_RP2040",
    "diode_direction": "ROW2COL",
    "features": {
        "bootmagic": true,
        "command": false,
        "console": false,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "rgblight": true,
        "oled": true,
        "via": true
    },
    "matrix_pins": {
        "cols": ["GP5", "GP6", "GP7"],
        "rows": ["GP2", "GP3", "GP4"]
    },
    "rgblight": {
        "pin": "GP16",
        "led_count": 1,
        "animations": {
            "breathing": true,
            "rainbow_mood": true,
            "rainbow_swirl": true,
            "static_gradient": true
        }
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"label": "K00", "x": 0, "y": 0, "matrix": [0, 0]},
                {"label": "K01", "x": 1, "y": 0, "matrix": [0, 1]},
                {"label": "K02", "x": 2, "y": 0, "matrix": [0, 2]},

                {"label": "K10", "x": 0, "y": 1, "matrix": [1, 0]},
                {"label": "K11", "x": 1, "y": 1, "matrix": [1, 1]},
                {"label": "K12", "x": 2, "y": 1, "matrix": [1, 2]},

                {"label": "K20", "x": 0, "y": 2, "matrix": [2, 0]},
                {"label": "K21", "x": 1, "y": 2, "matrix": [2, 1]},
                {"label": "K22", "x": 2, "y": 2, "matrix": [2, 2]}
            ]
        }
    }
}
